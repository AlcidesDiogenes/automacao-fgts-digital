# ========================================================
# Configurações do Sistema de Automações de Encargos
# ========================================================

# Certificado digital: o robô usa SOMENTE o certificado instalado no Windows.
# (PFX_PATH / PFX_PASSWORD não são mais lidos — ver docs/decisoes/ADR-0004.)

# Caminho da planilha com a lista de empresas (Excel .xlsx ou .csv)
EMPRESAS_EXCEL_PATH=data/empresas.xlsx

# Pasta onde as guias e relatórios serão salvos
OUTPUT_DIR=data/output

# Modo Headless: false para ver o navegador abrindo; true para rodar oculto
HEADLESS=false

# Timeout padrão em segundos para carregamento de páginas
BROWSER_TIMEOUT=60
